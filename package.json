{
  "name": "video-server-stack",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "client": "npm run dev:client",
    "server": "npm run dev:server",
    "clean": "npm run clean:client",
    "clean:client": "npm run clean --prefix client",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client",
    "ci": "npm run build && npm test",
    "test": "npm run test:client && npm run test:server",
    "test:client": "npm test --prefix client",
    "test:server": "npm test --prefix server",
    "generate:catalog": "npm run generate:catalog --prefix server"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
