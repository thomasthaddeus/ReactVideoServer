{
  "name": "my-react-video-server-client",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.7",
    "video-server-stack": "file:..",
    "web-vitals": "^5.3.0"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --configLoader native",
    "clean": "node ../scripts/clean-client-dist.mjs",
    "build": "vite build --configLoader native --emptyOutDir false",
    "preview": "vite preview --configLoader native",
    "test:client": "vitest run --configLoader native --pool=threads",
    "test": "vitest run --configLoader native --pool=threads"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
